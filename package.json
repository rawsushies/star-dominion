{
  "name": "star-dominion",
  "private": true,
  "version": "1.0.0",
  "description": "Star Dominion: an interstellar kingdom grand strategy simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "soak": "vitest run tests/soak.test.ts",
    "soak:seeds": "vite-node scripts/soak-seeds.ts",
    "candidates:fetch": "node scripts/fetch-candidates.mjs",
    "test:e2e": "playwright test",
    "candidates:capture": "node scripts/capture-candidates.mjs",
    "lab:capture": "node scripts/capture-capital-lab.mjs",
    "fuzz": "vite-node scripts/audit.ts",
    "fuzz:browser": "node scripts/browser-audit.cjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "5.1.0",
    "@fontsource/saira-semi-condensed": "^5.1.0",
    "@types/three": "^0.160.0",
    "firebase": "^10.14.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.160.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
